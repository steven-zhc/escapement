    "precheck": [
      {
        "description": "ensure constraint \"events_stream_id_version_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "events_stream_id_version_key",
          "public",
          "\"public\".\"events\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"events_stream_id_version_key\"",
        "sql": "ALTER TABLE \"public\".\"events\" ADD CONSTRAINT \"events_stream_id_version_key\" UNIQUE (\"stream_id\", \"version\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"events_stream_id_version_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
