# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never hold a real value.
#
# Escapement's own database — never one belonging to a managed project.

# Pooled connection (transaction mode). Ordinary reads and writes.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Session-mode connection to the SAME database. Required for migrations,
# LISTEN/NOTIFY and session-level advisory locks. Transaction pooling breaks all
# three, and breaks them silently — see doc/decisions/0009-two-connections.md.
# On Supabase: same host and credentials, port 5432, no pgbouncer flag.
# On a plain Postgres: this may be the same string as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/postgres"

# GitHub App credentials (doc/decisions/0006-github-app.md).
#
# An App rather than a token, because which repositories it can reach is explicit
# in its installation. Create it at Settings -> Developer settings -> GitHub Apps
# with these permissions, then install it on each managed repository:
#
#   Issues          read + write   work items, agent:* labels, comments
#   Contents        read + write   cloning, pushing agent/*, merging into base
#   Pull requests   read + write   opening and reading PRs
#   Metadata        read           required by GitHub
#
# The private key is a real secret. Keep the .pem outside the repository and
# point at it by path. `~` is expanded; a relative path is relative to the repo
# root, not to wherever you ran the command from.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=~/.escapement-app.pem
#
# Or, where only a single-line value can be carried, the PEM with \n escapes:
# GITHUB_APP_PRIVATE_KEY=
#
# No installation id is needed. It is looked up per repository, which is what
# makes "the App is not installed there" a message rather than a 404.
