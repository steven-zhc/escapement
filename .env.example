# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never hold a real value.
#
# Escapement's own database — never one belonging to a managed project.
DATABASE_URL="postgresql://user:password@localhost:5432/escapement"

# GitHub App credentials (doc/decisions/0006-github-app.md).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_INSTALLATION_ID=
