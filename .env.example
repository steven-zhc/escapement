# The event store. Its own database — never one belonging to a managed project,
# because Escapement has to keep running while a managed project is being changed.
DATABASE_URL="postgresql://user:password@localhost:5432/escapement?schema=public"

# GitHub App credentials (see doc/decisions/0006-github-app.md).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_INSTALLATION_ID=
